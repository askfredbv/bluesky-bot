# Required — core runtime
GEMINI_API_KEY=your_gemini_api_key_here
BLUESKY_USERNAME=askfred.be
BLUESKY_APP_PASSWORD=your_app_password_here

# Everything below is OPTIONAL. Keep it commented out unless you use it: a
# non-empty value is treated as configured, so an uncommented placeholder makes
# the bot try to use a dummy credential (e.g. cross-post to Mastodon and fail).

# Mastodon cross-posting (uncomment both to enable; otherwise Bluesky-only)
# MASTODON_ACCESS_TOKEN=your_mastodon_access_token_here
# MASTODON_API_BASE_URL=https://mastodon.social

# Remote state persistence across runs. GIST_ID + GIST_TOKEN store state in a
# private Gist; STATE_STORE_URL/TOKEN is an alternative HTTP key-value backend.
# Without any of these, state is kept locally.
# GIST_ID=your_private_gist_id_here
# GIST_TOKEN=your_gist_pat_here
# STATE_STORE_URL=https://example.com/state
# STATE_STORE_TOKEN=your_state_store_token_here

# Proactive replies (Phase 4): comma-separated handles to watch. Kept out of
# source on purpose; see src/config.py load_watchlist().
# PROACTIVE_REPLY_WATCHLIST=someone.bsky.social,another.bsky.social
